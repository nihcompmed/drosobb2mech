Step 02: Run the following code

bash -lc 'export CUBLAS_WORKSPACE_CONFIG=:4096:8; export PYTHONHASHSEED=0; export OMP_NUM_THREADS=1; export MKL_NUM_THREADS=1; \
> python Step02_finetune_efficiency_subject_adaptation.py \
>   --data-dir EEGMI_numpy \
>   --split-json checkpoints_vae_261028001/vae_universal_subjectsplit70_10_29_win9_hd512_ld8_beta3e-04_split123_sample123_torch123.split.json \
>   --pretrained-ckpt checkpoints_vae_261028001/vae_universal_subjectsplit70_10_29_win9_hd512_ld8_beta3e-04_split123_sample123_torch123.pth \
>   --outdir Step02_outputs/finetune_efficiency_epochbudget_cleanfix_ep3_R03to14 \
>   --which-split test \
>   --runs 3-14 \
>   --k-list 500 2000 10000 \
>   --epochs 3.0 \
>   --eval-epochs 0 0.1 0.2 0.5 1 2 3 \
>   --n-test 20000 \
>   --downsample-factor 30 \
>   --sample-seed 999 \
>   --subject-split-seed 2026 \
>   --torch-seed 2026 \
>   --batch-size 512 --lr 1e-3 \
>   --beta 3e-4 \
>   --device cuda'

if it succeeds, it should be like
